        <activity
            android:name=".BookDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".ChaptersActivity"
            android:exported="false" />

        <activity
            android:name=".SectionsActivity"
            android:exported="false" />

        <activity
            android:name=".QuestionsActivity"
            android:exported="false" />

        <activity
            android:name=".QuestionDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".TrainingBookSelectionActivity"
            android:exported="false" />

        <activity
            android:name=".TrainingConfigurationActivity"
            android:exported="false" />

        <activity
            android:name=".TrainingQuestionActivity"
            android:exported="false" />


        <activity android:name=".LearningHubActivity" android:exported="false" />
        <activity android:name=".SourcePagesActivity" android:exported="false" />
    </application>

</manifest>

